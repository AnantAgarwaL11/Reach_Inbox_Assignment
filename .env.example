# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── BullMQ Worker ───────────────────────────────────────────
# How many jobs one worker processes concurrently (async I/O, not threads)
WORKER_CONCURRENCY=5
# Minimum milliseconds between sends from the same sender
MIN_EMAIL_DELAY_MS=2000
# Global default hourly cap per sender (overridden by sender.hourlyLimit)
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ─── Session ─────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Slack OAuth ─────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:3001/api/slack/callback
SLACK_NOTIFICATION_CHANNEL=#email-alerts

# ─── Ethereal SMTP ───────────────────────────────────────────
# Leave blank to auto-create a fresh Ethereal test account on startup
ETHEREAL_USER=
ETHEREAL_PASS=

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ─── Encryption ──────────────────────────────────────────────
# 32-character hex key used to encrypt Slack tokens at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ─── Bull Board ──────────────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin_secret
